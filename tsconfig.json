{
  // Type-checks the functions and scripts; nothing is emitted. Netlify
  // bundles the functions itself (esbuild), and Node runs the scripts
  // directly by stripping their types, so only erasable syntax is allowed.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["netlify/functions/**/*.ts", "scripts/**/*.ts", "brand/**/*.ts"]
}
