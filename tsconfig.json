{
  // Type-checks the functions, scripts, brand code and the site's .ts files;
  // nothing is emitted. Netlify bundles the functions itself (esbuild), Node
  // runs the scripts directly by stripping their types, and Astro builds the
  // site, so only erasable syntax is allowed. .astro files are not checked:
  // astro check needs TypeScript's compiler API, which TypeScript 7 doesn't
  // have until 7.1.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"], // dom: the site's scripts (src/scripts)
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "astro/client"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["netlify/functions/**/*.ts", "scripts/**/*.ts", "brand/**/*.ts", "src/**/*.ts"]
}
