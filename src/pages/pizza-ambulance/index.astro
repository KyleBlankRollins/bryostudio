---
import Base from "../../layouts/Base.astro";
import { pizzaAmbulanceReleases, releaseDate, releasePath } from "../../lib/releases.ts";

const [latest] = await pizzaAmbulanceReleases();
---
<Base title="Pizza Ambulance" description="Pizza Ambulance: deliver stacked pizzas by bicycle across an open, hilly town. Coming to Android.">
  <p class="eyebrow">A game by Bryo Studio</p>
  <h1>Pizza Ambulance</h1>
  <p class="lede">You are a rider on a bicycle with a tower of pizzas strapped to the back. The town is open, hilly and in a hurry. Keep the pizzas hot. Keep them whole.</p>

  <!-- SCREENSHOT SPOT: add one or two game screenshots here later, e.g.
       <figure><img src="/pizza-ambulance/shot-1.webp" width="1280" height="720"
         alt="The rider climbing a hill with a stack of pizzas" loading="lazy"></figure>
       Keep them small (WebP, under ~150 KB each). -->

  <h2>What you do</h2>
  <ul class="features">
    <li>Take delivery jobs across town and earn medals for the good ones.</li>
    <li>Balance a stack of pizza boxes over hills, kerbs and corners. Every bump counts.</li>
    <li>Ride down to the harbour, where the wind pushes back and the drawbridge can be jumped if you are brave.</li>
    <li>Spend what you earn on hats and bigger racks, so you can carry more and look good doing it.</li>
  </ul>

  <h2>Coming to Android</h2>
  <p>Pizza Ambulance is in development and coming to Android first. This page will link to Google Play when it is out.</p>

  <h2>What's new</h2>
  {latest ? (
    <div class="card">
      <p class="status">Version {latest.data.version} · {releaseDate(latest.data.date)}</p>
      <p>{latest.data.summary}</p>
      <p><a href={releasePath(latest.data.version)}>Read about version {latest.data.version}</a>, or see <a href="/pizza-ambulance/whats-new/">every release</a>.</p>
    </div>
  ) : (
    <p>Every release will be written up on the <a href="/pizza-ambulance/whats-new/">What's new</a> page, with more room than the store gives.</p>
  )}

  <h2>Privacy</h2>
  <p>Read how the game handles your data in the <a href="/privacy/pizza-ambulance/">Pizza Ambulance privacy policy</a>.</p>

  <h2>Get in touch</h2>
  <p>Found a bug or have an idea? Write to <a href="mailto:hello@bryostudio.com">hello@bryostudio.com</a>.</p>
</Base>
