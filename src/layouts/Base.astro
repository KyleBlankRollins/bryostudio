---
// The shell of every page: head, header, footer. A page passes its title and
// description and puts its content in the slot, which becomes <main>.
import Tuft from "../components/Tuft.astro";
import "../styles/tokens.css";
import "../styles/styles.css";

interface Props {
  title?: string; // without " · Bryo Studio"; leave out on the home page
  description: string;
  noindex?: boolean; // keep the page out of search results (and the sitemap)
  wide?: boolean; // main runs wider than the reading column, for its own layout
  image?: string; // the link preview image, 1200 × 630, from public/; the studio's by default
  imageAlt?: string; // what the preview image shows
}

const {
  title,
  description,
  noindex = false,
  wide = false,
  image = "/og-image.png",
  imageAlt = "Bryo Studio: small software, grown slowly. One person making games, mobile apps and other software.",
} = Astro.props;
const fullTitle = title ? `${title} · Bryo Studio` : "Bryo Studio";
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
// Link previews (LinkedIn, Slack, Bluesky and others) need absolute addresses.
const imageUrl = new URL(image, Astro.site);

// The section a page belongs to is marked current: a privacy policy is under Privacy.
const nav = [
  { href: "/pizza-ambulance/", label: "Pizza Ambulance" },
  { href: "/ascribe/", label: "Ascribe" },
  { href: "/privacy/", label: "Privacy" },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <script is:inline src="/theme.js"></script>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {!noindex && <link rel="canonical" href={canonical}>}
  <meta property="og:site_name" content="Bryo Studio">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={imageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={imageAlt}>
  <meta name="twitter:card" content="summary_large_image">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="brand" href="/">
      <Tuft />
      Bryo Studio
    </a>
    <nav aria-label="Main">
      {nav.map(({ href, label }) => (
        <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>
      ))}
    </nav>
  </header>
  <main id="main" class:list={["page", { "page-wide": wide }]}>
    <slot />
  </main>
  <footer class="site-footer">
    <p>© 2026 Bryo Studio · <a href="/privacy/">Privacy</a> · <a href="mailto:hello@bryostudio.com">hello@bryostudio.com</a></p>
  </footer>
</body>
</html>
